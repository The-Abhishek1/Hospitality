SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKENS_JSON={}
# Set this to the Graph version configured for your Meta app.
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v25.0
# Off by default. Enabling permits due campaign expansion and campaign queue delivery.
WHATSAPP_CAMPAIGNS_ENABLED=false
# Same 32-byte hex encryption key as the web server for managed hotel authorizations.
WHATSAPP_ENCRYPTION_KEY=

# Prefer the scheduled Supabase worker for hosted delivery; do not run two consumers unnecessarily.
WHATSAPP_AUTOMATIONS_ENABLED=false
GUEST_PORTAL_URL=
