NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Guest tasks use APP_URL; a separate guest portal deployment is not required.
APP_URL=http://localhost:3000
# Optional secure WhatsApp onboarding uses server-only credentials.
# See .env.whatsapp.example and docs/vercel-deployment.md.
# Never expose backend keys through NEXT_PUBLIC_ variables.
# Server-only team invitation emails. Supabase Auth SMTP is configured separately.
RESEND_API_KEY=
TEAM_EMAIL_FROM="Xcloak Hospitality <admin@xcloak.tech>"
# Backend-only key used to record provider email results.
SUPABASE_SERVICE_ROLE_KEY=
